                        startActivity(launchIntent)
                    }
                }
            } else {
                system_message("error while parsing geo coordinates, detail = "+result.message, MTYPE.ERROR)
            }
            */
            // 4. Now safely finish the activity after everything has launched and logged
            kotlinx.coroutines.delay(10000) // Brief pause to let user read debug messages
            finish()
        }
    }

    private fun unshortenUrlViaKotlin(shortUrl: String): Result {
        var result:Result = Result()

        var currentUrl = shortUrl
        try {
            var connection: java.net.HttpURLConnection? = null
            var redirectCount = 0
            val maxRedirects = 5

            while (redirectCount < maxRedirects) {
                val url = java.net.URL(currentUrl)
                connection = url.openConnection() as java.net.HttpURLConnection
                connection.instanceFollowRedirects = false // Manually track redirects like Python
                connection.connectTimeout = 5000
                connection.readTimeout = 5000
                // Use a standard mobile browser User-Agent so Google treats it like a real device
                connection.setRequestProperty("User-Agent", "Mozilla/5.0 (Linux; Android 14; Mobile) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Mobile Safari/537.36")
                connection.connect()

                val responseCode = connection.responseCode
                system_message(connection.responseMessage, MTYPE.SUCCESS)
                if (responseCode in 300..399) {
                    val location = connection.getHeaderField("Location")
                    system_message(location.toString(), MTYPE.SUCCESS)
                    if (!location.isNullOrEmpty()) {
                        // Handle relative redirect paths if necessary
                        currentUrl = if (location.startsWith("http")) {
                            location
                        } else {
                            java.net.URL(url, location).toString()
                        }
                        redirectCount++
                        connection.disconnect()
                        continue
                    }
                }
                break
            }
            connection?.disconnect()
        } catch (e: Exception) {
            result.message =e.message.toString()
            e.printStackTrace()
        }

        result.uri = Uri.parse(currentUrl)
        return result
    }





    private fun process_url_via_webbrowser(shortUrl: String): Result{
        var result:Result = Result();

        try {
            val url = java.net.URL("https://maps.app.goo.gl/pd4TSBkybhHY3PgD9")
            val connection = url.openConnection() as java.net.HttpURLConnection
            connection.instanceFollowRedirects = true
            connection.connectTimeout = 10000
            connection.readTimeout = 10000
            connection.setRequestProperty("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36")
            connection.connect()


            val responseCode = connection.responseCode
            if (responseCode == HttpURLConnection.HTTP_OK) {
                // This will give you the final resolved Google Maps URL
                result.uri= Uri.parse(connection.url.toString())
                result.status = true
            } else if (responseCode in 300..399) {
                // Fallback: If it still returns a redirect code, grab the Location header
               result.uri = Uri.parse(connection.getHeaderField("Location").toString())
               result.status = true

            }
            connection.disconnect()


            /*
            val headerField = connection.getHeaderField("Location")
            if (!headerField.isNullOrEmpty()) {
                val latLongRegex = "@(-?\\d+\\.\\d+),(-?\\d+\\.\\d+)".toRegex()
