                    result.uri = Uri.parse("geo:$lat,$lon?q=$lat,$lon(Destination)")
                }
            }
            else
                result.message="header field is null or empty"
            */


        } catch (e: Exception) {
            result.message = e.message.toString()
            e.printStackTrace()
        }
        return result
    }
}