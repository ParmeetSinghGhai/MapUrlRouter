        system_message("working on uri:: $fullUrl", MTYPE.SUCCESS)

        lifecycleScope.launch {
            // 1. Resolve the short link in the background to get the real coordinates
            val result = withContext(Dispatchers.IO) {
                system_message("parsing geo coordinates from url. please wait..", MTYPE.SUCCESS)
                //process_url_via_webbrowser(fullUrl)
                unshortenUrlViaKotlin(fullUrl)
            }
            system_message(result.uri.toString() + " " + result.message,MTYPE.SUCCESS)

