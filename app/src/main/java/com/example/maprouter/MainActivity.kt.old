package com.example.maprouter

import android.content.Context
import android.content.Intent
import android.graphics.Color
import android.net.Uri
import android.os.Bundle
import android.widget.Button
import android.widget.ScrollView
import android.widget.TextView
import androidx.appcompat.app.AppCompatActivity
import androidx.recyclerview.widget.LinearLayoutManager
import androidx.recyclerview.widget.RecyclerView
import java.time.Instant
import androidx.lifecycle.lifecycleScope
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.launch
import kotlinx.coroutines.withContext
import java.net.HttpURLConnection

enum class MTYPE
{
    SUCCESS,
    ERROR
}

class Result
{
    public var uri:Uri = Uri.parse("error")
    public var message:String = "null"
    public var status:Boolean = false
    init
    {
        message = "null"
        status = false
        uri = Uri.parse("error")
    }
}


class MainActivity : AppCompatActivity() {

    private lateinit var currentAppLabel: TextView
    private lateinit var saveButton: Button
    private lateinit var debugBox: TextView
    private lateinit var debugScroll: ScrollView


    private var tempSelectedPackage: String? = null
    private var tempSelectedAppName: String? = null
    private val prefsName = "MapInterceptorPrefs"
    private val keySavedPackage = "saved_package_name"
    private val keySavedAppName = "saved_app_name"


    private fun system_message(message:String,type: MTYPE)
    {
        if(type== MTYPE.SUCCESS)
        {
            debugBox.setTextColor(Color.MAGENTA);
            debugBox.append(Instant.now().toString() + ": "+message+ "\n");
        }
        else if(type == MTYPE.ERROR)
        {
            debugBox.setTextColor(Color.RED);
            debugBox.append(Instant.now().toString() + ": "+message+ "\n");
        }
        debugScroll?.post {
            debugScroll.fullScroll(ScrollView.FOCUS_DOWN)
        }
    }


    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        val sharedPrefs = getSharedPreferences(prefsName, Context.MODE_PRIVATE)
        val savedPackage = sharedPrefs.getString(keySavedPackage, null)

        setContentView(R.layout.activity_main)
        debugScroll = findViewById<ScrollView>(R.id.debugScroll)
        debugBox = findViewById(R.id.debugBox)
        debugBox.text = "";
        system_message("application started",MTYPE.SUCCESS)

        // 1. Check if the app was opened via an external link (ACTION_VIEW)
        if (intent?.action == Intent.ACTION_VIEW && intent?.data != null) {
            val linkUri = intent.data!!
            if (savedPackage != null) {
                // If a default app is already saved, forward immediately and close
                forwardLinkToApp(savedPackage, linkUri)
                return
            }
        }



        currentAppLabel = findViewById(R.id.currentAppLabel)
        saveButton = findViewById(R.id.saveButton)

        val savedAppName = sharedPrefs.getString(keySavedAppName, "None") ?: "None"
        currentAppLabel.text = "Current Default App: $savedAppName"

        val recyclerView = findViewById<RecyclerView>(R.id.recyclerViewApps)
        recyclerView.layoutManager = LinearLayoutManager(this)

        // Query all installed packages
        val packages = packageManager.getInstalledPackages(0)
        val appList = packages.mapNotNull { packageInfo ->
            val appInfo = packageInfo.applicationInfo ?: return@mapNotNull null
            val appName = packageManager.getApplicationLabel(appInfo).toString()
            val packageName = packageInfo.packageName
            val icon = try {
                packageManager.getApplicationIcon(packageName)
            } catch (e: Exception) {
                getDrawable(android.R.drawable.sym_def_app_icon)!!
            }
            AppInfo(appName, packageName, icon)
        }.sortedBy { it.name }

        // 3. Handle list item selection (staging the choice)
        recyclerView.adapter = AppAdapter(appList) { selectedApp ->
            tempSelectedPackage = selectedApp.packageName
            tempSelectedAppName = selectedApp.name
            saveButton.isEnabled = true
            saveButton.text = "Save '${selectedApp.name}' as Default"
        }

        // 4. Handle Save Button click to persist selection
        saveButton.setOnClickListener {
            val pkg = tempSelectedPackage
            val name = tempSelectedAppName
            if (pkg != null && name != null) {
                sharedPrefs.edit().apply {
                    putString(keySavedPackage, pkg)
                    putString(keySavedAppName, name)
                    apply()
                }
                currentAppLabel.text = "Current Default App: $name"
                saveButton.text = "Saved Successfully!"
                saveButton.isEnabled = false
            }
        }
    }



